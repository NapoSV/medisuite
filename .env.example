# ─── Base de datos ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinica_dev
DB_USERNAME=clinica_app
DB_PASSWORD=

# Solo para Docker (usuario root)
DB_ROOT_PASSWORD=

# ─── JWT ────────────────────────────────────────────────
# Mínimo 256 bits (32 caracteres aleatorios)
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Aplicación ─────────────────────────────────────────
APP_PORT=8080
APP_ENV=development
# Valores: development | staging | production

# ─── Frontend ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ─── Multi-tenant ───────────────────────────────────────
# ID del tenant de demo para desarrollo local
DEFAULT_TENANT_ID=1
