# ─── Base de datos (PostgreSQL) ─────────────────────────
# Para la BD compartida (Neon): host pooler + tu usuario individual (ver Teams)
# Para local: DB_HOST=localhost y DB_SSLMODE=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_dev
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# ─── JWT ────────────────────────────────────────────────
# Mínimo 256 bits (32 caracteres aleatorios)
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Aplicación ─────────────────────────────────────────
APP_PORT=8080
APP_ENV=development
# Valores: development | staging | production

# ─── Frontend ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ─── Multi-tenant ───────────────────────────────────────
# ID del tenant de demo para desarrollo local
DEFAULT_TENANT_ID=1
