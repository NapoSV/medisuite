# ─── Base de datos (PostgreSQL) ─────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_dev
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Credenciales que usa Flyway para aplicar migraciones.
# La tabla flyway_schema_history en Neon es propiedad de neondb_owner,
# por lo que Flyway DEBE conectarse con ese rol (no con el rol de app).
# Si se dejan vacías, Flyway cae al fallback DB_USERNAME/DB_PASSWORD y falla
# con "permission denied for table flyway_schema_history".
DB_FLYWAY_USERNAME=
DB_FLYWAY_PASSWORD=

# ─── JWT ────────────────────────────────────────────────
# Mínimo 256 bits (32 caracteres aleatorios)
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Aplicación ─────────────────────────────────────────
APP_PORT=8097
APP_ENV=development
# Valores: development | staging | production

# ─── Frontend ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8097
VITE_TENANT_SLUG=clinica-san-rafael

# ─── Multi-tenant ───────────────────────────────────────
# ID del tenant de demo para desarrollo local
DEFAULT_TENANT_ID=1
